<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Path-jail property tests. net10.0 so they also run on the Linux CI runner for speed,
    but see the warning in Silt.Safety.csproj: the WINDOWS run is the authoritative one.

    xUnit v2 is deliberate, not stale. xUnit v3 runs on Microsoft.Testing.Platform, whose
    filter options differ from VSTest's - and a silently-ignored category filter would run
    destructive tests unintentionally. For this codebase that is the worst possible failure
    mode, so we stay on the filter mechanism whose behaviour is verifiable.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\Silt.Safety\Silt.Safety.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
