<Window x:Class="Silt.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Silt" Height="800" Width="1280"
        MinHeight="600" MinWidth="900"
        Background="#0B0E14"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!--
            The WebView2 environment is created in code-behind, not here, because it must
            be constructed with an explicit user data folder. See MainWindow.xaml.cs.
        -->
        <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />

        <!-- Shown until the renderer signals ready, and left visible on failure. -->
        <Border x:Name="StatusPanel" Background="#0B0E14">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
                <TextBlock Text="Silt"
                           FontSize="34" FontWeight="SemiBold" Foreground="#E6EDF3"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusText"
                           Text="Starting..."
                           FontSize="13" Foreground="#7D8590" Margin="0,14,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock x:Name="StatusDetail"
                           FontSize="11.5" Foreground="#6E7681" Margin="0,14,0,0"
                           TextWrapping="Wrap" TextAlignment="Left"
                           FontFamily="Cascadia Mono, Consolas, monospace"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
