<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Silt.Api - the HTTP surface, hosted IN-PROCESS inside Silt.Shell.

    There is no TCP listener. Requests arrive via WebView2's WebResourceRequested
    interception and are dispatched to this pipeline directly. A loopback TCP port
    would be reachable by any local process and by any web page in any browser -
    on a component that can delete files, that is not an acceptable trade.
    CI enforces this: see the "No TCP listener anywhere" gate in ci.yml.

    FrameworkReference (rather than PackageReference) is how a class library opts
    into the shared ASP.NET Core framework.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Silt.Core\Silt.Core.csproj" />
    <ProjectReference Include="..\Silt.Safety\Silt.Safety.csproj" />
  </ItemGroup>

</Project>
