<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Silt.Api - the API surface, dispatched IN-PROCESS from the shell.

    There is no TCP listener and no ASP.NET Core host. Requests arrive through WebView2's
    WebResourceRequested interception and are routed by SiltApiRouter directly.

    Hosting Kestrel here was the original plan and was dropped deliberately: a loopback port
    is reachable by any local process and by any page in any browser, which is unacceptable
    for a component that will eventually delete files. The CI gate in ci.yml enforces the
    absence of a listener. Avoiding the ASP.NET Core host also keeps tens of megabytes out of
    a working set that is already over budget.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Silt.Core\Silt.Core.csproj" />
    <ProjectReference Include="..\Silt.Safety\Silt.Safety.csproj" />
  </ItemGroup>

</Project>
